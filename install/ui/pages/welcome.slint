import { Button } from "std-widgets.slint";

export component WelcomePage inherits Rectangle {
    width: 600px;
    height: 400px;

    callback next();

    VerticalLayout {
        alignment: center;
        spacing: 24px;

        Text {
            text: "Piksel设计协同";
            font-size: 24px;
        }

        Text {
            text: "欢迎来到Piksel设计协同平台！";
        }
        HorizontalLayout {
            alignment: center;
            Button {
                text: "开始安装";
                width: 140px;
                clicked => {
                    root.next();
                }
            }
        }

    }
}

