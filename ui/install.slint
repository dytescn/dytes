// Piksel 应用安装向导（仅 app 类型）。
// 设计 token 参考 funxdata/stylesheet：
// 主文本 #334155、次要 #64748B、边框 #D1D5DB、背景 #F3F4F6；
// 正文 14px、辅助 12px，按钮使用品牌色 #70ffaf。

import { LineEdit } from "std-widgets.slint";

// ---------- 通用按钮 ----------

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    width: 148px;
    height: 40px;
    border-radius: 8px;
    background: !root.enabled ? #D1D5DB : (touch.has-hover ? #5ee89a : #70ffaf);

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.text;
        color: #0f2d20;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    width: 112px;
    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #70ffaf;
    background: !root.enabled ? #F3F4F6 : (touch.has-hover ? #d6ffe9 : #e8fff3);

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.text;
        color: #1b5e45;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---------- 进度条 ----------

component ProgressBar inherits Rectangle {
    in property <float> value: 0.0;

    height: 4px;
    border-radius: 2px;
    background: #E5E7EB;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * root.value;
        border-radius: 2px;
        background: #70ffaf;
    }
}

// ---------- 顶部步骤 ----------

component StepBar inherits HorizontalLayout {
    in property <int> current: 0;

    spacing: 8px;
    alignment: center;

    for label[idx] in ["选择位置", "安装", "完成"] : HorizontalLayout {
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: idx <= root.current ? #70ffaf : #D1D5DB;
        }

        Text {
            text: label;
            font-size: 12px;
            color: idx <= root.current ? #1b5e45 : #64748B;
            vertical-alignment: center;
        }

        if idx < 2 : Rectangle {
            width: 22px;
            height: 1px;
            background: #D1D5DB;
        }
    }
}

// ---------- 第 1 页：欢迎 ----------

component WelcomePage inherits Rectangle {
    width: 100%;
    height: 100%;
    callback next();

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 40px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 68px;
                height: 68px;
                border-radius: 18px;
                background: #E6FFF3;

                Text {
                    text: "P";
                    font-size: 34px;
                    font-weight: 700;
                    color: #1b5e45;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: "安装 Piksel 应用";
            font-size: 24px;
            font-weight: 600;
            color: #334155;
            horizontal-alignment: center;
        }

        Text {
            text: "选择安装位置后，将下载并安装应用及依赖。";
            font-size: 14px;
            color: #64748B;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;

            PrimaryButton {
                text: "开始安装";
                clicked => {
                    root.next();
                }
            }
        }
    }
}

// ---------- 第 2 页：选择安装位置 ----------

component InstallPage inherits Rectangle {
    width: 100%;
    height: 100%;

    in-out property <string> install_path;
    callback browse();
    callback next();
    callback back();

    VerticalLayout {
        spacing: 16px;
        padding: 32px;

        Text {
            text: "选择安装位置";
            font-size: 24px;
            font-weight: 600;
            color: #334155;
        }

        Text {
            text: "Piksel 将安装到下面的目录，请选择有写入权限的位置。";
            font-size: 14px;
            color: #64748B;
        }

        Rectangle {
            height: 1px;
            background: #D1D5DB;
        }

        HorizontalLayout {
            height: 32px;
            spacing: 10px;

            Text {
                text: "安装目录";
                font-size: 12px;
                color: #64748B;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            SecondaryButton {
                text: "浏览...";
                width: 88px;
                height: 32px;
                clicked => {
                    root.browse();
                }
            }
        }

        Rectangle {
            width: 100%;
            height: 40px;
            border-radius: 8px;
            border-width: 1px;
            border-color: #D1D5DB;
            background: transparent;

            LineEdit {
                text <=> root.install_path;
                width: 100%;
                height: 100%;
                font-size: 14px;
                read-only: true;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.browse();
                }
            }
        }

        Text {
            text: "安装器只处理 app 类型包；其他包请使用 dytes install <type>。";
            font-size: 12px;
            color: #64748B;
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;

            SecondaryButton {
                text: "上一步";
                clicked => {
                    root.back();
                }
            }

            PrimaryButton {
                text: "开始安装";
                clicked => {
                    root.next();
                }
            }
        }
    }
}

// ---------- 第 3 页：安装进度 ----------

component InstallingPage inherits Rectangle {
    width: 100%;
    height: 100%;

    callback prev();

    in-out property <float> total_progress: 0.0;
    in-out property <float> file_progress: 0.0;
    in-out property <string> status_text: "准备开始下载...";
    in property <bool> failed: false;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 42px;

        Text {
            text: root.failed ? "安装未完成" : "正在安装";
            font-size: 24px;
            font-weight: 600;
            color: root.failed ? #EF4444 : #334155;
            horizontal-alignment: center;
        }

        Text {
            text: root.status_text;
            font-size: 14px;
            color: root.failed ? #EF4444 : #64748B;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 6px;
            width: 100%;

            HorizontalLayout {
                Text {
                    text: "下载进度";
                    font-size: 12px;
                    color: #64748B;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: round(root.total_progress * 100) + "%";
                    font-size: 12px;
                    color: #64748B;
                }
            }

            ProgressBar {
                value: root.total_progress;
            }
        }

        if root.failed : SecondaryButton {
            text: "返回修改目录";
            clicked => {
                root.prev();
            }
        }

        if !root.failed : Text {
            text: "安装过程中请勿关闭窗口";
            font-size: 12px;
            color: #64748B;
            horizontal-alignment: center;
        }
    }
}

// ---------- 第 4 页：完成 ----------

component FinishPage inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <string> install_path;
    in property <string> error_text: "";
    callback launch_app();
    callback close_window();

    VerticalLayout {
        alignment: center;
        spacing: 14px;
        padding: 40px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 68px;
                height: 68px;
                border-radius: 34px;
                background: #ECFDF5;

                Text {
                    text: "✓";
                    font-size: 32px;
                    color: #10B981;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: "安装完成";
            font-size: 24px;
            font-weight: 600;
            color: #334155;
            horizontal-alignment: center;
        }

        Text {
            text: "Piksel 已安装到：";
            font-size: 12px;
            color: #64748B;
            horizontal-alignment: center;
        }

        Rectangle {
            border-radius: 8px;
            background: #FFFFFF;
            border-width: 1px;
            border-color: #D1D5DB;

            VerticalLayout {
                padding: 10px;

                Text {
                    text: root.install_path;
                    font-size: 12px;
                    color: #64748B;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            alignment: center;

            PrimaryButton {
                text: "启动 Piksel";
                clicked => {
                    root.launch_app();
                }
            }
        }

        if root.error_text != "" : Text {
            text: root.error_text;
            font-size: 12px;
            color: #EF4444;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;

            SecondaryButton {
                text: "关闭";
                clicked => {
                    root.close_window();
                }
            }
        }
    }
}

// ---------- 主窗口 ----------

export component MainWindow inherits Window {
    width: 720px;
    height: 500px;
    title: "Piksel 应用安装";
    background: #F3F4F6;

    in-out property <int> page_idx: 0;
    in-out property <string> install_path: "/opt/piksel";
    in-out property <bool> install_failed: false;
    in-out property <string> launch_error: "";
    callback start_install();
    callback open_browse_dialog();
    callback launch_app();
    callback close_window();

    // 安装进度透传
    in-out property <float> total_progress: 0.0;
    in-out property <float> file_progress: 0.0;
    in-out property <string> download_status: "";

    VerticalLayout {
        padding: 26px;
        spacing: 18px;

        // 顶部品牌与步骤
        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: #70ffaf;

                Text {
                    text: "P";
                    color: #0f2d20;
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: "Piksel";
                    font-size: 18px;
                    font-weight: 600;
                    color: #334155;
                }

                Text {
                    text: "应用安装向导";
                    font-size: 12px;
                    color: #64748B;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            StepBar {
                current: root.page_idx >= 3 ? 2 : (root.page_idx >= 2 ? 1 : 0);
            }
        }

        // 内容卡片
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            background: #FFFFFF;
            border-width: 1px;
            border-color: #D1D5DB;

            WelcomePage {
                visible: root.page_idx == 0;
                next => {
                    root.page_idx = 1;
                }
            }

            InstallPage {
                visible: root.page_idx == 1;
                install_path <=> root.install_path;

                back => {
                    root.page_idx = 0;
                }
                next => {
                    root.page_idx = 2;
                    root.start_install();
                }
                browse => {
                    root.open_browse_dialog();
                }
            }

            InstallingPage {
                visible: root.page_idx == 2;
                failed: root.install_failed;

                prev => {
                    root.install_failed = false;
                    root.page_idx = 1;
                }

                total_progress <=> root.total_progress;
                file_progress <=> root.file_progress;
                status_text <=> root.download_status;
            }

            FinishPage {
                visible: root.page_idx == 3;
                install_path: root.install_path;
                error_text: root.launch_error;
                launch_app => {
                    root.launch_app();
                }
                close_window => {
                    root.close_window();
                }
            }
        }

        Text {
            text: "dytes · Piksel 包管理";
            font-size: 12px;
            color: #64748B;
            horizontal-alignment: center;
        }
    }
}
