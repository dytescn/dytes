// Piksel 更新窗口：展示更新状态、进度与重启入口。

// ---------- 按钮 ----------

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> base: #3498db;
    in property <color> hover: #2f89c5;
    callback clicked();

    width: 148px;
    height: 40px;
    border-radius: 8px;
    background: !root.enabled ? #d5dbdf : (touch.has-hover ? root.hover : root.base);

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.text;
        color: white;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---------- 进度条 ----------

component ProgressBar inherits Rectangle {
    in property <float> value: 0.0;

    height: 4px;
    border-radius: 2px;
    background: #ecf0f1;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * root.value;
        border-radius: 2px;
        background: #3498db;
    }
}

// ---------- 更新窗口 ----------

export component UpdatePage inherits Window {
    width: 460px;
    height: 340px;
    title: "Piksel 更新";
    background: #f5f6f8;

    in property <string> status_text: "";
    in property <float> progress_value: 0.0;
    in property <bool> show_progress: false;
    in property <bool> show_restart: false;

    callback update_clicked();
    callback restart_clicked();

    VerticalLayout {
        padding: 22px;
        spacing: 16px;

        // 品牌头部
        HorizontalLayout {
            spacing: 10px;

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: #3498db;

                Text {
                    text: "P";
                    color: white;
                    font-size: 17px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: "Piksel 更新";
                    font-size: 16px;
                    font-weight: 600;
                    color: #2c3e50;
                }

                Text {
                    text: "保持应用为最新版本";
                    font-size: 11px;
                    color: #7f8c8d;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        // 内容卡片
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            background: white;
            border-width: 1px;
            border-color: #e6e9ec;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                alignment: center;

                Text {
                    text: root.status_text;
                    font-size: 13px;
                    color: #34495e;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if root.show_progress : VerticalLayout {
                    spacing: 6px;
                    width: 100%;

                    HorizontalLayout {
                        Text {
                            text: "更新进度";
                            font-size: 11px;
                            color: #7f8c8d;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: round(root.progress_value) + "%";
                            font-size: 11px;
                            color: #7f8c8d;
                        }
                    }

                    ProgressBar {
                        value: root.progress_value / 100;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                if !root.show_restart : HorizontalLayout {
                    alignment: center;

                    ActionButton {
                        text: "开始更新";
                        enabled: !root.show_progress;
                        clicked => {
                            root.update_clicked();
                        }
                    }
                }

                if root.show_restart : HorizontalLayout {
                    alignment: center;

                    ActionButton {
                        text: "重启应用";
                        base: #27ae60;
                        hover: #219150;
                        clicked => {
                            root.restart_clicked();
                        }
                    }
                }

                Text {
                    text: root.show_restart ? "更新完成，重启后生效" :
                          root.show_progress ? "正在更新，请勿关闭应用" :
                          "点击按钮检查并安装更新";
                    font-size: 11px;
                    color: #95a5a6;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
