// Piksel 更新窗口：状态、进度与单个更新按钮。
// 设计 token 参考 funxdata/stylesheet：正文 14px、辅助 12px，
// 主文本 #334155、次要 #64748B、边框 #D1D5DB、背景 #F3F4F6。

// ---------- 按钮 ----------

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> base: #70ffaf;
    in property <color> hover: #5ee89a;
    callback clicked();

    width: 132px;
    height: 36px;
    border-radius: 8px;
    background: !root.enabled ? #D1D5DB : (touch.has-hover ? root.hover : root.base);

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.text;
        color: #0f2d20;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---------- 进度条 ----------

component ProgressBar inherits Rectangle {
    in property <float> value: 0.0;

    height: 4px;
    border-radius: 2px;
    background: #E5E7EB;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * root.value;
        border-radius: 2px;
        background: #70ffaf;
    }
}

// ---------- 更新窗口 ----------

export component UpdatePage inherits Window {
    width: 400px;
    height: 260px;
    title: "Piksel 更新";
    background: #F3F4F6;

    in property <string> status_text: "";
    in property <float> progress_value: 0.0;
    in property <bool> show_progress: false;
    in property <bool> show_restart: false;

    callback update_clicked();
    callback restart_clicked();

    VerticalLayout {
        padding: 20px;

        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            background: #FFFFFF;
            border-width: 1px;
            border-color: #D1D5DB;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                alignment: center;

                Text {
                    text: root.status_text;
                    font-size: 14px;
                    color: #334155;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if root.show_progress : VerticalLayout {
                    spacing: 6px;
                    width: 100%;

                    HorizontalLayout {
                        Text {
                            text: "更新进度";
                            font-size: 12px;
                            color: #64748B;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: round(root.progress_value) + "%";
                            font-size: 12px;
                            color: #64748B;
                        }
                    }

                    ProgressBar {
                        value: root.progress_value / 100;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                if !root.show_restart : HorizontalLayout {
                    alignment: center;

                    ActionButton {
                        text: "开始更新";
                        enabled: !root.show_progress;
                        clicked => {
                            root.update_clicked();
                        }
                    }
                }

                if root.show_restart : HorizontalLayout {
                    alignment: center;

                    ActionButton {
                        text: "重启应用";
                        clicked => {
                            root.restart_clicked();
                        }
                    }
                }
            }
        }
    }
}
