export component UpdatePage inherits Window {
    width: 320px;
    height: 240px;
    title: "Piksel更新";
    
    in property <string> status_text: "";
    in property <float> progress_value: 0.0;
    in property <bool> show_progress: false;
    in property <bool> show_restart: false;
    
    callback update_clicked();
    callback restart_clicked();
    
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        
        Text {
            text: status_text;
            font-size: 14px;
            color: #34495e;
            horizontal-alignment: center;
        }
        
        Rectangle {
            width: 100%;
            height: 6px;
            visible: show_progress;
            background: #ecf0f1;
            border-radius: 3px;
            
            Rectangle {
                x: 0px;
                width: (parent.width / 100) * progress_value;
                height: 100%;
                background: #3498db;
                border-radius: 3px;
                animate width {
                    duration: 150ms;
                }
            }
        }
        
        Rectangle {
            width: 100%;
            height: 34px;
            
            Rectangle {
                width: 120px;
                height: 34px;
                x: (parent.width - 120px) / 2;
                background: show_progress || show_restart ? #bdc3c7 : #3498db;
                border-radius: 4px;
                visible: !show_restart;
                touch1 := TouchArea {
                    enabled: !show_progress && !show_restart;
                    clicked => {
                        update_clicked();
                    }
                }
                
                Text {
                    text: "开始更新";
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 14px;
                    font-weight: 500;
                }
            }
            
            Rectangle {
                width: 120px;
                height: 34px;
                x: (parent.width - 120px) / 2;
                background: show_restart ? #27ae60 : #bdc3c7;
                border-radius: 4px;
                visible: show_restart;
                touch2 := TouchArea {
                    enabled: show_restart;
                    clicked => {
                        restart_clicked();
                    }
                }
                
                Text {
                    text: "重启应用";
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 14px;
                    font-weight: 500;
                }
            }
        }
        
        Text {
            text: show_progress ? "正在更新，请勿关闭程序..." : 
                  show_restart ? "更新完成！" : 
                  "点击上方按钮开始";
            font-size: 12px;
            color: #95a5a6;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}