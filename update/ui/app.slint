export component UpdatePage inherits Window {
    width: 320px;
    height: 240px;
    title: "Piksel更新";
    
    in property <string> status_text: "";
    in property <float> progress_value: 0.0;
    in property <bool> show_progress: false;
    in property <bool> show_restart: false;
    
    callback update_clicked();
    callback restart_clicked();
    
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        
        // 状态文字
        Text {
            text: status_text;
            font-size: 14px;  // 稍微调大一点，更易读
            color: #34495e;
            horizontal-alignment: center;
        }
        
        // 进度条
        Rectangle {
            width: 100%;
            height: 28px;
            visible: show_progress;
            background: #ecf0f1;
            border-radius: 4px;
            
            Rectangle {
                width: progress_value * 1px;
                height: 100%;
                background: #3498db;
                border-radius: 4px;
                // 添加平滑动画效果
                animate width {
                    duration: 150ms;
                }
            }
        }
        
        // ===== 按钮容器（居中） =====
        Rectangle {
            width: 100%;
            height: 34px;
            
            // 计算居中偏移：总宽度192px (90+12+90)
            // 容器宽度320-48(padding)=272，居中偏移 = (272-192)/2 = 40px
            // 使用 40px 可以让按钮更居中
            Rectangle {
                x: 90px;  // 居中偏移量
                y: 0px;
                width: 192px;  // 固定总宽度
                height: 34px;
                
                HorizontalLayout {
                    spacing: 12px;
                    
                    // --- 开始更新按钮 ---
                    Rectangle {
                        width: 90px;
                        height: 34px;
                        background: !show_progress && !show_restart ? #3498db : #bdc3c7;
                        border-radius: 4px;
                        touch1 := TouchArea {
                            enabled: !show_progress && !show_restart;
                            clicked => {
                                update_clicked();
                            }
                        }
                        
                        Text {
                            text: "开始更新";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 14px;
                            font-weight: 500;  // 稍微加粗
                        }
                    }
                    
                    // --- 重启应用按钮 ---
                    Rectangle {
                        width: 90px;
                        height: 34px;
                        background: show_restart ? #27ae60 : #bdc3c7;
                        border-radius: 4px;
                        visible: show_restart;
                        touch2 := TouchArea {
                            enabled: show_restart;
                            clicked => {
                                restart_clicked();
                            }
                        }
                        
                        Text {
                            text: "重启应用";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 14px;
                            font-weight: 500;  // 稍微加粗
                        }
                    }
                }
            }
        }
        
        // 底部提示文字
        Text {
            text: show_progress ? "正在更新，请勿关闭程序..." : 
                  show_restart ? "更新完成！" : 
                  "点击上方按钮开始";
            font-size: 12px;
            color: #95a5a6;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

